generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Untuk Neon/Supabase (pooler): isi DATABASE_URL_UNPOOLED dengan koneksi non-pooled.
  // Kalau tidak pakai pooler, isi sama dengan DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ScheduleSource {
  SIAKAD
  MANUAL
}

enum ScheduleType {
  COURSE
  PRACTICUM
  ASSISTANT
  OTHER
}

enum Role {
  MAHASISWA
  ADMIN
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  nim              String?
  prodi            String?
  image            String?
  activeSemesterId String?
  role             Role      @default(MAHASISWA)
  /// Terakhir membuka aplikasi (di-update maksimal tiap 5 menit)
  lastSeenAt       DateTime?
  /// Heartbeat dari tab yang sedang terbuka; null = offline (tab ditutup / logout)
  onlineAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  semesters     Semester[]
  scheduleItems ScheduleItem[]
  auditLogs     AuditLog[]
}

model Semester {
  id        String   @id @default(cuid())
  userId    String
  number    Int
  /// Semester pendek (SP) setelah semester genap `number`; opsional, hanya jika diambil
  isShort   Boolean  @default(false)
  label     String?
  /// Link Google Sheets SPS (sumber hari + jam) untuk semester ini
  spsUrl    String?
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleItems ScheduleItem[]

  @@unique([userId, number, isShort])
}

model ScheduleItem {
  id          String         @id @default(cuid())
  userId      String
  semesterId  String
  type        ScheduleType   @default(COURSE)
  source      ScheduleSource
  title       String
  courseCode  String?
  courseName  String?
  className   String?
  room        String?
  lecturers   String[]       @default([])
  sks         String?
  /// 1 = Senin ... 5 = Jumat. Null jika belum cocok dengan SPS.
  day         Int?
  startTime   String?
  endTime     String?
  notes       String?
  /// Kunci stabil untuk data SIAKAD (kode|kelas|sesi). Null untuk MANUAL.
  sourceId    String?
  isManual    Boolean        @default(false)
  matchStatus MatchStatus    @default(MATCHED)
  /// Kandidat baris SPS saat matching ambigu
  candidates  Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([userId, semesterId, source, sourceId])
  @@index([userId, semesterId])
}


/// Catatan aktivitas (append-only). Snapshot actor disimpan supaya histori
/// tetap benar walau user mengganti nama/role.
model AuditLog {
  id          String   @id @default(cuid())

  actorId     String?
  actorName   String?
  actorEmail  String?
  actorRole   String?

  action      String
  category    String
  description String

  targetType  String?
  targetId    String?
  targetName  String?

  beforeData  Json?
  afterData   Json?
  metadata    Json?

  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([category])
  @@index([targetType])
  @@index([createdAt])
  @@index([actorRole])
}

// ---- Auth.js ----

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
